# -----------------------------------------------------------------------------
# OpenSEO — self-hosted (CapRover / Docker). No Cloudflare account required.
# -----------------------------------------------------------------------------

# Required: base64 of "login:password" from DataForSEO.
# printf '%s' 'YOUR_LOGIN:YOUR_PASSWORD' | base64
# DATAFORSEO_API_KEY=

# Recommended: protect the whole app with HTTP Basic Auth.
# Without these, anyone who finds your URL can spend your DataForSEO credits.
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASSWORD=change-me

# Optional: AI features (audit fixes, keyword clustering, LLM sentiment).
# Any OpenAI-compatible API works (OpenAI, OpenRouter, Groq, Ollama, Gemini...).
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Optional: daily automation (Rank Tracking + LLM Mentions).
# CRON_ENABLED=true
# CRON_HOUR_UTC=3
# DISCORD_WEBHOOK_URL=
# APP_URL=https://openseo.yourdomain.com

# Optional app port (CapRover uses 80)
# PORT=80
